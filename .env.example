# Copiá este archivo como ".env" y completá tus datos.

# Claude (https://console.anthropic.com -> API Keys)
CLAUDE_API_KEY=

# WhatsApp Cloud API (developers.facebook.com -> tu app -> WhatsApp)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=tecnoriv123

# Tu número personal, para que el bot te avise cuando alguien quiere comprar (ej: 5493584123456)
OWNER_PHONE=
# Opcional: idioma de las plantillas de WhatsApp (postventa y resumen diario). Por defecto es_AR
WA_IDIOMA_PLANTILLAS=

# Supabase (supabase.com -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_KEY=

# Contraseña para entrar al panel (/panel)
PANEL_PASSWORD=

# Estudio de contenido: publicar en Instagram solo (opcional, ver README)
IG_TOKEN=
# Opcionales: se detectan solos
IG_USER_ID=
PUBLIC_URL=

# Catálogo: número al que llegan los pedidos (opcional; si no, usa el whatsapp de src/negocio.js)
WHATSAPP_PEDIDOS=

# Opcional: ID de la app de Meta, solo si falla subir la foto de perfil de WhatsApp desde /gestion
META_APP_ID=

# Estudio IA de /contenido (Nano Banana Pro). aistudio.google.com -> Get API key (Pro necesita facturación)
GEMINI_API_KEY=
